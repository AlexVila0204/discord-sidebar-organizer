{
  "manifest_version": 3,
  "name": "Discord AI Sidebar Organizer",
  "version": "1.0.0",
  "description": "Organiza tus servidores de Discord usando IA y Model Context Protocol",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Discord AI Organizer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.discord.com/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.discord.com/*"
      ],
      "js": [
        "content/content.js"
      ],
      "css": [
        "content/overlay.css"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.discord.com/*"
      ],
      "js": [
        "content/inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/inject.js",
        "icons/*"
      ],
      "matches": [
        "*://*.discord.com/*"
      ]
    }
  ]
}
